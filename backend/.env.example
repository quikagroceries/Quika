ENVIRONMENT=development
DEBUG=true
DATABASE_URL=postgresql+asyncpg://quika:quika@db:5432/quika

JWT_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# One-time admin bootstrap — this phone number gets role=admin on every
# startup (see app/admin/service.py::bootstrap_admin). Leave blank if you
# don't need an auto-provisioned admin account.
BOOTSTRAP_ADMIN_PHONE=

# Comma-separated list of origins allowed to call this API (CORS). Must
# include your deployed frontend's real origin in production - the
# localhost default below only works for local dev.
ALLOWED_ORIGINS=http://localhost:3003,http://localhost:3000,http://localhost:5173

# Paystack — get these from your Paystack dashboard (use TEST keys for now)
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx

# Risk model
DEFAULT_BASKET_CAP_KOBO=500000
PAYMENT_WINDOW_MINUTES=45

# OTP delivery - Termii handles SMS (primary), WhatsApp and voice (fallbacks).
# Leave SMS_API_KEY empty in dev: codes come back as `dev_otp` instead of being
# sent. In production set it (and a Termii-approved SMS_SENDER_ID).
SMS_API_KEY=
SMS_SENDER_ID=Qyka
# How long the UI waits before offering "WhatsApp" / "Call me", and the
# server-side minimum gap between two code requests for one number.
OTP_FALLBACK_AFTER_SECONDS=45
OTP_RESEND_COOLDOWN_SECONDS=30

# WhatsApp Business API provider (360dialog / Twilio) — add later
WHATSAPP_API_KEY=

# Transactional email provider (Resend / Postmark / SES) — add later. Until
# set, email OTPs behave like SMS today: shown in dev, never actually sent.
EMAIL_API_KEY=

# LiveKit (voice/video call prototype) — from your LiveKit Cloud project
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Google Maps (delivery tracking) — not wired up yet, DeliveryTracking.jsx
# still uses the keyless embed. Fill this in and wire it server-side when
# ready.
GOOGLE_MAPS_API_KEY=

# Google Sign-In — OAuth Client ID from Google Cloud Console (Credentials →
# OAuth client ID → Web application). Must match the frontend's
# NEXT_PUBLIC_GOOGLE_CLIENT_ID exactly — the backend verifies ID tokens
# against this as the expected audience.
GOOGLE_CLIENT_ID=
