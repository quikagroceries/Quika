# Backend API base URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Cloudinary unsigned upload — chat/purchase/packing photos go straight from
# the browser to Cloudinary. The cloud name and unsigned preset name are
# meant to be public (that's how Cloudinary's unsigned-upload model works),
# but keeping them as env vars means switching Cloudinary accounts doesn't
# require touching code.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset

# Google Sign-In — OAuth Client ID from Google Cloud Console (Credentials →
# OAuth client ID → Web application). Must match the backend's
# GOOGLE_CLIENT_ID exactly.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
